# This file is organized by repository role, not by mod name. A normal new
# mods/<ModName> project should not need another rule: source, Defs, Languages,
# Patches, Textures, About previews/identity, release profiles, and reviewed
# Workshop sources remain trackable. Add a rule only for a new generated form.

# Editors and operating-system metadata
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini

# Repository and per-project build output
/artifacts/
**/[Bb]in/
**/[Oo]bj/
**/[Oo]ut/
**/[Dd]ist/
**/TestResults/
**/*.received.*
*.trx
*.coverage
*.coveragexml
**/coverage/
*.nupkg
*.snupkg
/packages/
/.nuget/
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json

# Generated state for every mod under mods/<ModName> and every test owner
/mods/*/About/About.xml
**/Defs/DefsSchema.xsd
**/DevIntegrationTests/
**/DevEndToEndTests/
**/.DevEndToEndTests.stage.*/
**/.DevEndToEndTests.backup.*/
.rimworld-integration-test-stage.owner
.rimworld-integration-test-transaction.json
**/SavedData/
Player.log
ModsConfig.xml
*.rws
*.dmp
*.dump

# Logs, temporary files, and repository-local reports
*.log
*.tmp
*.bak
*.cache
/reports/
/audits/
/screenshots/
/docs/LocalDependencies.md
/docs/RequirementsGaps.md
/docs/TddEvidence.md

# Local Codex runtime state. Repository skills are committed under .agents/skills.
/.codex/cache/
/.codex/tmp/
/.codex/state/

# Downloaded tools, package-manager caches, and local environments
/.tools/
/.tooling/
/downloads/
/vendor/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
!.env.example
