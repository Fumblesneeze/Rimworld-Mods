<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef Name="ImmersiveChefs_AssistantStationBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>35</pathCost>
    <useHitPoints>true</useHitPoints>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Production</designationCategory>
    <researchPrerequisites><li>ImmersiveChefs_ProfessionalKitchens</li></researchPrerequisites>
    <costList><Steel>55</Steel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <statBases><WorkToBuild>1200</WorkToBuild><MaxHitPoints>150</MaxHitPoints><Flammability>0.3</Flammability><Cleanliness>1</Cleanliness></statBases>
    <size>(2,1)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>120</basePowerConsumption></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Facility"><maxSimultaneous>1</maxSimultaneous></li>
    </comps>
    <placeWorkers><li>PlaceWorker_ShowFacilitiesConnections</li><li>PlaceWorker_PreventInteractionSpotOverlap</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="ImmersiveChefs_AssistantStationBase">
    <defName>ImmersiveChefs_SauceStation</defName><label>sauce station</label><description>A linked specialist station for sauces, seasoning and finishing work.</description>
    <graphicData><texPath>Things/Building/Production/TableDrugLab</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2,1)</drawSize></graphicData>
    <modExtensions><li Class="ImmersiveChefs.KitchenAssistantStationExtension"><stationRole>sauce</stationRole></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="ImmersiveChefs_AssistantStationBase">
    <defName>ImmersiveChefs_MeatStation</defName><label>meat station</label><description>A linked specialist station for meat trimming and concurrent preparation.</description>
    <graphicData><texPath>Things/Building/Production/TableButcher</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2,1)</drawSize></graphicData>
    <modExtensions><li Class="ImmersiveChefs.KitchenAssistantStationExtension"><stationRole>meat</stationRole></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="ImmersiveChefs_AssistantStationBase">
    <defName>ImmersiveChefs_VegetableStation</defName><label>vegetable station</label><description>A linked specialist station for vegetable preparation and garnishing.</description>
    <graphicData><texPath>Things/Building/Production/TableButcher</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2,1)</drawSize></graphicData>
    <modExtensions><li Class="ImmersiveChefs.KitchenAssistantStationExtension"><stationRole>vegetable</stationRole></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="ImmersiveChefs_AssistantStationBase">
    <defName>ImmersiveChefs_PastryStation</defName><label>pastry station</label><description>A linked specialist station for dough, pastry and dessert preparation.</description>
    <graphicData><texPath>Things/Building/Production/TableTailorHand</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2,1)</drawSize></graphicData>
    <modExtensions><li Class="ImmersiveChefs.KitchenAssistantStationExtension"><stationRole>pastry</stationRole></li></modExtensions>
  </ThingDef>
</Defs>
