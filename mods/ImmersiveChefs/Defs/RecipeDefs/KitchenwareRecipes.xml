    <recipeUsers><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
    <modExtensions><li Class="ImmersiveChefs.KitchenwareRecipeExtension"><product>Cookware</product><fabricationTier>Intermediate</fabricationTier></li></modExtensions>
  </RecipeDef>

