<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef Name="ImmersiveChefs_KitchenwareRecipeBase" Abstract="True">
    <workAmount>900</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <productHasIngredientStuff>true</productHasIngredientStuff>
    <fixedIngredientFilter>
      <categories>
        <li>Root</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

  <RecipeDef ParentName="ImmersiveChefs_KitchenwareRecipeBase">
    <defName>ImmersiveChefs_MakePrimitiveCookware</defName>
    <label>make primitive stone cookware</label>
    <description>Make one primitive cookware set from stone blocks, with wood for handles and utensils.</description>
    <jobString>Making primitive stone cookware.</jobString>
    <ingredients>
      <li><filter><categories><li>Root</li></categories></filter><count>40</count></li>
      <li><filter><thingDefs><li>WoodLog</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <products><ImmersiveChefs_Cookware>1</ImmersiveChefs_Cookware></products>
    <recipeUsers><li>CraftingSpot</li></recipeUsers>
    <modExtensions><li Class="ImmersiveChefs.KitchenwareRecipeExtension"><product>Cookware</product><fabricationTier>PrimitiveStone</fabricationTier></li></modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="ImmersiveChefs_KitchenwareRecipeBase">
