    <jobString>Smithing cookware set.</jobString>
    <workAmount>1500</workAmount>
    <ingredients>
      <li><filter /><count>6</count></li>
      <li><filter><thingDefs><li>WoodLog</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <products><ImmersiveChefs_Cookware>1</ImmersiveChefs_Cookware></products>
    <recipeUsers><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
    <modExtensions><li Class="ImmersiveChefs.KitchenwareRecipeExtension"><product>Cookware</product><fabricationTier>Intermediate</fabricationTier></li></modExtensions>
  </RecipeDef>

