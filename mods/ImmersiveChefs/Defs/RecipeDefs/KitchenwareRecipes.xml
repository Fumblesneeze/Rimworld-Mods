<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef Name="ImmersiveChefs_KitchenwareRecipeBase" Abstract="True">
    <workAmount>900</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <ingredientValueGetterClass>ImmersiveChefs.IngredientValueGetter_Units</ingredientValueGetterClass>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <productHasIngredientStuff>true</productHasIngredientStuff>
    <fixedIngredientFilter />
  </RecipeDef>

  <RecipeDef Name="ImmersiveChefs_SmithingKitchenwareRecipeBase" ParentName="ImmersiveChefs_KitchenwareRecipeBase" Abstract="True">
    <requiredGiverWorkType>Smithing</requiredGiverWorkType>
  </RecipeDef>

  <RecipeDef ParentName="ImmersiveChefs_KitchenwareRecipeBase">
    <defName>ImmersiveChefs_MakePrimitiveCookware</defName>
    <label>make primitive stone cookware set</label>
    <description>Make one primitive cookware set from stone blocks, with wood for handles and utensils.</description>
    <jobString>Making primitive stone cookware set.</jobString>
    <ingredients>
      <li><filter /><count>5</count></li>
      <li><filter><thingDefs><li>WoodLog</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <products><ImmersiveChefs_PrimitiveCookware>1</ImmersiveChefs_PrimitiveCookware></products>
    <recipeUsers><li>CraftingSpot</li></recipeUsers>
    <modExtensions><li Class="ImmersiveChefs.KitchenwareRecipeExtension"><product>Cookware</product><fabricationTier>PrimitiveStone</fabricationTier></li></modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="ImmersiveChefs_KitchenwareRecipeBase">
    <defName>ImmersiveChefs_MakePrimitivePlates</defName>
    <label>make primitive stone plates x4</label>
    <description>Make four crude plates from stone blocks.</description>
    <jobString>Making primitive stone plates.</jobString>
    <ingredients><li><filter /><count>4</count></li></ingredients>
    <products><ImmersiveChefs_Plate>4</ImmersiveChefs_Plate></products>
    <recipeUsers><li>CraftingSpot</li></recipeUsers>
    <modExtensions><li Class="ImmersiveChefs.KitchenwareRecipeExtension"><product>Plate</product><fabricationTier>PrimitiveStone</fabricationTier></li></modExtensions>
  </RecipeDef>

