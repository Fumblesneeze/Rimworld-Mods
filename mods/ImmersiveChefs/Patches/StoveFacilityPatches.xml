      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="ElectricStove" or defName="FueledStove"]/comps</xpath>
        <value>
          <li Class="CompProperties_AffectedByFacilities">
            <linkableFacilities>
              <li>ImmersiveChefs_SauceStation</li>
