        <xpath>Defs/ThingDef[defName="ElectricStove" or defName="FueledStove"]</xpath>
        <value>
          <li Class="ImmersiveChefs.KitchenwareAlertStationExtension" />
        </value>
      </li>
    </operations>
  </Operation>
