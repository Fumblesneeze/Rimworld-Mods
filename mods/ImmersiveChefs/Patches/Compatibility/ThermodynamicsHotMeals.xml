<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
          <ThingDef ParentName="BuildingBase">
            <defName>ImmersiveChefs_Microwave</defName>
            <label>microwave</label>
            <description>A compact powered appliance that reheats one cold plated meal before eating. Reheating restores temperature at a small cost to culinary quality and safety.</description>
            <thingClass>ImmersiveChefs.Building_Microwave</thingClass>
            <graphicData><texPath>ImmersiveChefs/Things/Building/Appliance/Microwave</texPath><graphicClass>Graphic_Multi</graphicClass><shaderType>Cutout</shaderType><drawSize>(1.5,1.5)</drawSize></graphicData>
            <size>(1,1)</size>
            <drawerType>MapMeshOnly</drawerType>
            <tickerType>Rare</tickerType>
            <altitudeLayer>BuildingOnTop</altitudeLayer>
            <blocksAltitudes><li>BuildingOnTop</li></blocksAltitudes>
            <passability>PassThroughOnly</passability>
            <fillPercent>0.25</fillPercent>
            <useHitPoints>true</useHitPoints>
            <rotatable>true</rotatable>
            <clearBuildingArea>false</clearBuildingArea>
            <minifiedDef>MinifiedThing</minifiedDef>
            <thingCategories><li>BuildingsMisc</li></thingCategories>
            <hasInteractionCell>true</hasInteractionCell>
            <interactionCellOffset>(0,0,-1)</interactionCellOffset>
            <building><isEdifice>false</isEdifice></building>
            <placeWorkers><li>ImmersiveChefs.PlaceWorker_MicrowaveCountertop</li></placeWorkers>
            <designationCategory>Production</designationCategory>
            <researchPrerequisites><li>Electricity</li></researchPrerequisites>
            <costList><Steel>35</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
            <statBases><WorkToBuild>800</WorkToBuild><MaxHitPoints>100</MaxHitPoints><Mass>10</Mass><Flammability>0.2</Flammability></statBases>
            <comps>
              <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>700</basePowerConsumption></li>
              <li Class="CompProperties_Flickable" />
              <li Class="CompProperties_Breakdownable" />
              <li Class="ImmersiveChefs.CompProperties_Microwave"><heatingTicks>180</heatingTicks></li>
            </comps>
          </ThingDef>
        </value>
      </li>
      <li Class="ImmersiveChefs.PatchOperationTextureVariations">
        <match Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationAdd">
              <xpath>/Defs/ThingDef[defName="ImmersiveChefs_Microwave"]/comps</xpath>
              <value>
                <li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
                  <randomGraphics><li>ImmersiveChefs/Things/Building/Appliance/Microwave</li><li>ImmersiveChefs/Things/Building/Appliance/Microwave_Variant01</li></randomGraphics>
                  <optionalNames><li>standard microwave</li><li>alternate microwave</li></optionalNames>
                </li>
              </value>
            </li>
          </operations>
        </match>
      </li>
      <li Class="ImmersiveChefs.PatchOperationRemoveIfModActive">
        <packageId>Mlie.DThermodynamicsHotMeals</packageId>
        <xpath>/Defs/ThingDef[defName="ImmersiveChefs_Microwave"]</xpath>
      </li>
    </operations>
  </Operation>
</Patch>
