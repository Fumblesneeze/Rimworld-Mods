<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="Caravan_Neolithic_BulkGoods" or defName="Base_Neolithic_Standard"]/stockGenerators</xpath>
        <value>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_PrimitiveCookware</thingDef>
            <product>Cookware</product>
            <fabricationTiers><li>PrimitiveStone</li></fabricationTiers>
            <countRange>-3~1</countRange>
            <maxTechLevelGenerate>Neolithic</maxTechLevelGenerate>
          </li>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_Plate</thingDef>
            <product>Plate</product>
            <fabricationTiers><li>PrimitiveStone</li><li>Soft</li></fabricationTiers>
            <countRange>-1~4</countRange>
            <maxTechLevelGenerate>Neolithic</maxTechLevelGenerate>
          </li>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_Cutlery</thingDef>
            <product>Cutlery</product>
            <fabricationTiers><li>Soft</li></fabricationTiers>
            <countRange>-1~4</countRange>
            <maxTechLevelGenerate>Neolithic</maxTechLevelGenerate>
          </li>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="Caravan_Outlander_BulkGoods" or defName="Base_Outlander_Standard" or defName="Orbital_BulkGoods"]/stockGenerators</xpath>
        <value>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_Cookware</thingDef>
            <product>Cookware</product>
            <fabricationTiers><li>Intermediate</li><li>Modern</li></fabricationTiers>
            <countRange>-2~1</countRange>
            <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
          </li>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_Plate</thingDef>
            <product>Plate</product>
            <fabricationTiers><li>PrimitiveStone</li><li>Soft</li><li>Intermediate</li><li>Modern</li></fabricationTiers>
            <countRange>-1~4</countRange>
            <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
          </li>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_Cutlery</thingDef>
            <product>Cutlery</product>
            <fabricationTiers><li>Soft</li><li>Intermediate</li><li>Modern</li></fabricationTiers>
            <countRange>-1~4</countRange>
            <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
          </li>
          <li Class="ImmersiveChefs.StockGenerator_Kitchenware">
            <thingDef>ImmersiveChefs_ChefsKnife</thingDef>
            <product>ChefsKnife</product>
            <fabricationTiers><li>Intermediate</li><li>Modern</li></fabricationTiers>
            <countRange>-3~1</countRange>
            <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
          </li>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="Caravan_Outlander_Exotic" or defName="Orbital_Exotic"]/stockGenerators</xpath>
        <value>
          <li Class="StockGenerator_SingleDef">
            <thingDef>ImmersiveChefs_GlitterworldCookware</thingDef>
            <countRange>-3~1</countRange>
            <maxTechLevelGenerate>Ultra</maxTechLevelGenerate>
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
