<Project>
  <Import Project="Sdk.props" Sdk="Zlepper.RimWorld.ModSdk" Version="0.0.9" />
  <PropertyGroup>
    <RimWorldPath>$(DefaultRimWorldPath)</RimWorldPath>
    <RimWorldManagedPath>$(RimWorldPath)\RimWorldWin64_Data\Managed</RimWorldManagedPath>
    <SteamModContentFolder>$(DefaultSteamModContentFolder)</SteamModContentFolder>
    <RimWorldModName>Immersive Chefs</RimWorldModName>
    <RimWorldPackageId>fumblesneeze.immersivechefs</RimWorldPackageId>
    <RimWorldDistributionKind>Product</RimWorldDistributionKind>
    <Authors>Fumblesneeze</Authors>
    <AssemblyName>ImmersiveChefs</AssemblyName>
    <RootNamespace>ImmersiveChefs</RootNamespace>
    <IncludeHarmony>true</IncludeHarmony>
    <OutputFolder>$(ArtifactsRoot)Mods</OutputFolder>
    <Description>
      Adds Stuff-aware kitchenware, meal service, sanitation, preparation, cooperative cooking,
      culinary quality and temperature, dining standards, and guarded optional integrations.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <RimWorldSteamModDependency Include="imranfish.xmlextensions" />
    <RimWorldLoadAfter Include="Ludeon.RimWorld.Royalty" />
    <RimWorldLoadAfter Include="syrchalis.processor.framework" />
    <RimWorldLoadAfter Include="Argon.ExpandedMaterials.Metals" />
    <RimWorldLoadAfter Include="Argon.ExpandedMaterials.Masonry" />
    <RimWorldLoadAfter Include="zal.ceramics" />
    <RimWorldLoadAfter Include="Mlie.SimplySublimeABSPolymer" />
    <RimWorldLoadAfter Include="Dubwise.DubsBadHygiene" />
    <RimWorldLoadAfter Include="Orion.Gastronomy" />
    <RimWorldLoadAfter Include="avilmask.CommonSense" />
    <RimWorldLoadAfter Include="Orion.Hospitality" />
    <RimWorldLoadAfter Include="Evyatar108.VarietyMattersImprovedRedux" />
    <RimWorldLoadAfter Include="VanillaExpanded.VanillaFoodVarietyExpanded" />
    <RimWorldLoadAfter Include="Thekiborg.DMTR" />
    <RimWorldLoadAfter Include="Goat.Food.Texture.Variety.Core" />
    <RimWorldLoadAfter Include="Goat.Food.Texture.Variety" />
    <RimWorldLoadAfter Include="Goat.Food.Texture.Variety.VECooking" />
    <RimWorldLoadAfter Include="Goat.Food.Texture.Variety.VEStew" />
    <RimWorldLoadAfter Include="Goat.Food.Texture.Variety.VESushi" />
    <RimWorldLoadAfter Include="OskarPotocki.VanillaFactionsExpanded.Core" />
    <RimWorldLoadAfter Include="VanillaExpanded.VTEXVariations" />
    <RimWorldLoadAfter Include="VanillaExpanded.VNutrientE" />
    <RimWorldLoadAfter Include="rabiosus.AdaptiveMealBill" />
    <RimWorldLoadAfter Include="binchcannon.overcookedmeals" />
    <RimWorldLoadAfter Include="Memegoddess.MealsOnWheels" />
    <RimWorldLoadAfter Include="seekiworksmod.no10" />
    <RimWorldLoadAfter Include="sumghai.Replimat" />
    <RimWorldLoadAfter Include="sumghai.ReplimatMeals" />
    <RimWorldLoadAfter Include="Mlie.MealPrinter" />
    <RimWorldLoadAfter Include="Mlie.DThermodynamicsHotMeals" />
    <RimWorldLoadAfter Include="Mlie.RC2.Core" />
    <RimWorldLoadAfter Include="Mlie.RC2.MaME" />
    <RimWorldLoadAfter Include="Mlie.RC2.BaBE" />
    <RimWorldLoadAfter Include="Mlie.RC2.SaSE" />
    <RimWorldLoadAfter Include="Mlie.NoVanillaMeals" />
    <RimWorldLoadAfter Include="Mehni.PickUpAndHaul" />
    <RimWorldLoadAfter Include="lordfelix.CookForYourself" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Zlepper.RimWorld.ModSdk" Version="0.0.9" />

  <Target Name="RemoveLegacyConditionalMicrowaveLayout" BeforeTargets="Build;CopyMod">
    <Delete Files="$(ModSpecificOutputfolder)\LoadFolders.xml" />
    <RemoveDir Directories="$(OutputVersionFolder)\FallbackTemperature" />
    <Delete Files="$(RimWorldModPackageFolder)\LoadFolders.xml" />
    <RemoveDir Directories="$(RimWorldModPackageFolder)\1.6\FallbackTemperature" />
    <Delete Files="$(OutputVersionFolder)\Defs\ThingDefs\Microwave.xml" />
    <Delete Files="$(RimWorldModPackageFolder)\1.6\Defs\ThingDefs\Microwave.xml" />
    <Delete Files="$(OutputVersionFolder)\Textures\Things\Building\Microwave\Microwave.png" />
    <Delete Files="$(RimWorldModPackageFolder)\1.6\Textures\Things\Building\Microwave\Microwave.png" />
  </Target>

  <Target Name="RemoveRejectedSingleViewBuildingTextures" BeforeTargets="Build;CopyMod">
    <ItemGroup>
      <LegacySingleViewBuildingTexture Include="Appliance\Microwave;Appliance\Microwave_Variant01" />
      <LegacySingleViewBuildingTexture Include="Dishwasher\Dishwasher;Dishwasher\Dishwasher_Variant01" />
      <LegacySingleViewBuildingTexture Include="Dishwasher\IndustrialDishwasher;Dishwasher\IndustrialDishwasher_Variant01" />
      <LegacySingleViewBuildingTexture Include="KitchenStation\PrepStation;KitchenStation\PrepStation_Variant01" />
      <LegacySingleViewBuildingTexture Include="KitchenStation\SauceStation;KitchenStation\SauceStation_Variant01" />
      <LegacySingleViewBuildingTexture Include="KitchenStation\MeatStation;KitchenStation\MeatStation_Variant01" />
      <LegacySingleViewBuildingTexture Include="KitchenStation\VegetableStation;KitchenStation\VegetableStation_Variant01" />
      <LegacySingleViewBuildingTexture Include="KitchenStation\PastryStation;KitchenStation\PastryStation_Variant01" />
    </ItemGroup>
    <Delete Files="@(LegacySingleViewBuildingTexture->'$(OutputVersionFolder)\Textures\ImmersiveChefs\Things\Building\%(Identity).png')" />
    <Delete Files="@(LegacySingleViewBuildingTexture->'$(RimWorldModPackageFolder)\1.6\Textures\ImmersiveChefs\Things\Building\%(Identity).png')" />
  </Target>

  <Target Name="RemoveDisposableVisualComparisonAssets" BeforeTargets="Build;CopyMod">
    <Delete Files="$(OutputVersionFolder)\Defs\ThingDefs\VisualGeneratorComparison.xml" />
    <Delete Files="$(RimWorldModPackageFolder)\1.6\Defs\ThingDefs\VisualGeneratorComparison.xml" />
    <RemoveDir Directories="$(OutputVersionFolder)\Textures\ImmersiveChefs\Dev\GeneratorComparison" />
    <RemoveDir Directories="$(RimWorldModPackageFolder)\1.6\Textures\ImmersiveChefs\Dev\GeneratorComparison" />
  </Target>

  <!-- ModSdk 0.0.9's optional XSD generator cannot traverse RimWorld 1.6's
       recursive Def graph. XML is instead validated by the staged Def host and
       the in-game finalized-Def suite. Keep this opt-in until the SDK is fixed. -->
  <PropertyGroup>
    <ImmersiveChefsGenerateDefXsd Condition="'$(ImmersiveChefsGenerateDefXsd)' == ''">false</ImmersiveChefsGenerateDefXsd>
  </PropertyGroup>
  <Target Name="GenerateDefXsds"
          AfterTargets="Build;CopyMod"
          Inputs="@(RimWorldDefFiles);@(Reference);@(RimWorldCompilationResult)"
          Outputs="$(DefsXsdFileName)"
          Condition="'$(ImmersiveChefsGenerateDefXsd)' == 'true' and '@(RimWorldResourceDefs)' != ''">
    <GenerateXdsFilesForDefs References="@(Reference)"
                             RimWorldCompilationResult="@(RimWorldCompilationResult)"
                             RimWorldDefFiles="@(RimWorldDefFiles)"
                             XmlSchemaFileName="$(DefsXsdFileName)" />
  </Target>
</Project>
