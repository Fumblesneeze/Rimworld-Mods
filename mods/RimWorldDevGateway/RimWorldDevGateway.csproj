<Project Sdk="Zlepper.RimWorld.ModSdk/0.0.9">
  <PropertyGroup>
    <RimWorldPath>$(DefaultRimWorldPath)</RimWorldPath>
    <RimWorldManagedPath>$(RimWorldPath)\RimWorldWin64_Data\Managed</RimWorldManagedPath>
    <SteamModContentFolder>$(DefaultSteamModContentFolder)</SteamModContentFolder>
    <RimWorldModName>RimWorld Dev Gateway</RimWorldModName>
    <RimWorldPackageId>fumblesneeze.rimworlddevgateway</RimWorldPackageId>
    <RimWorldDistributionKind>DevelopmentOnly</RimWorldDistributionKind>
    <Authors>Fumblesneeze</Authors>
    <AssemblyName>RimWorldDevGateway</AssemblyName>
    <RootNamespace>RimWorldDevGateway</RootNamespace>
    <OutputFolder>$(ArtifactsRoot)Mods</OutputFolder>
    <Description>
      DANGER: developer-only local automation gateway. Starts an authenticated loopback API with
      unrestricted in-process code execution. Never enable for normal play or an untrusted session.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\..\shared\RimWorldDevGateway.Contracts\RimWorldDevGateway.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\RimWorldDevGateway.EndToEndTesting\RimWorldDevGateway.EndToEndTesting.csproj" />
    <ProjectReference Include="..\..\shared\RimWorldDevGateway.IntegrationTesting\RimWorldDevGateway.IntegrationTesting.csproj" />
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="Mono.CSharp" Version="4.0.0.143" />
  </ItemGroup>

  <!-- Language discovery happens before RimWorld resolves versioned load folders. These files
       provide metadata only so isolated E2E runs can activate product locales that are not
       installed in Core; they intentionally contain no Gateway or base-game translations. -->
  <Target Name="StageGatewayLocaleProviderMetadata" BeforeTargets="OutputRimWorldResources">
    <ItemGroup>
      <GatewayLocaleProviderMetadata Include="Languages\**\LanguageInfo.xml" />
      <RimWorldResourceLanguages Remove="Languages\**\LanguageInfo.xml" />
    </ItemGroup>
    <Copy
      SourceFiles="@(GatewayLocaleProviderMetadata)"
      DestinationFiles="$(ModSpecificOutputfolder)\Languages\%(RecursiveDir)%(Filename)%(Extension)" />
    <Delete Files="@(GatewayLocaleProviderMetadata->'$(OutputVersionFolder)\Languages\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
