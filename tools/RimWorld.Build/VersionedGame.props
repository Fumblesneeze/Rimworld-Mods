<Project>
  <!-- Explicit opt-in: existing product projects keep their target framework. -->
  <PropertyGroup>
    <RimWorldVersionedBuild>true</RimWorldVersionedBuild>
    <RequestedRimWorldVersion>$(RimWorldVersion)</RequestedRimWorldVersion>
    <RimWorldVersion>unsupported</RimWorldVersion>
    <RimWorldFullVersion Condition="Exists('$(RimWorldPath)/Version.txt')">$([System.IO.File]::ReadAllText('$(RimWorldPath)/Version.txt').Trim())</RimWorldFullVersion>
    <RimWorldVersion Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RimWorldFullVersion)', '^1\.[67]\.[0-9]+( rev[0-9]+)?$'))">$([System.String]::Copy('$(RimWorldFullVersion)').Substring(0, 3))</RimWorldVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <TargetFramework>net480</TargetFramework>
    <RimWorldManagedPath>$(RimWorldPath)\RimWorldWin64_Data\Managed</RimWorldManagedPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldManagedPath>$(RimWorldPath)</RimWorldManagedPath>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
