    <TargetFramework>net10.0</TargetFramework>
    <RimWorldPath>$(DefaultRimWorldPath)</RimWorldPath>
    <AssemblyName>PathfindingLab.EndToEndTests</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RimWorldEndToEndTest>true</RimWorldEndToEndTest>
    <RimWorldEndToEndTestOwnerPackageId>fumblesneeze.pathfindinglab</RimWorldEndToEndTestOwnerPackageId>
  </PropertyGroup>
  <Import Project="../../tools/RimWorld.Build/VersionedGame.props" />
  <Import Project="../../tools/RimWorld.Build/VersionedGame.targets" />
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(DefaultSteamModContentFolder)/2009463077/1.7/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="../../mods/PathfindingLab/PathfindingLab.csproj" />
    <ProjectReference Include="../../shared/RimWorldDevGateway.EndToEndTesting/RimWorldDevGateway.EndToEndTesting.csproj" />
  </ItemGroup>
</Project>
