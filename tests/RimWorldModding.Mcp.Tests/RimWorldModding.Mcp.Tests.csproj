<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RimWorldModding.Mcp.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../RimWorldDevGateway.EndToEndHost.Tests/EndToEndXmlFixtureTests.cs" Link="EndToEndXmlFixtureTests.cs" />
    <Compile Include="../RimWorldDevGateway.EndToEndHost.Tests/EndToEndNativeXmlLoaderTests.cs" Link="EndToEndNativeXmlLoaderTests.cs" />
    <Compile Include="../RimWorldDevGateway.EndToEndHost.Tests/EndToEndMetadataDiscoveryTests.cs" Link="EndToEndMetadataDiscoveryTests.cs" />
    <Compile Include="../RimWorldDevGateway.EndToEndHost.Tests/EndToEndHostCliTests.cs" Link="EndToEndHostCliTests.cs" />
    <Compile Include="../RimWorldDevGateway.Tests/RimWorldEndToEndRunnerCliTests.cs" Link="RimWorldEndToEndRunnerCliTests.cs" />
    <Compile Include="../RimWorldDevGateway.Tests/GatewaySmokeCleanupAggregationTests.cs" Link="GatewaySmokeCleanupAggregationTests.cs" />
    <ProjectReference Include="..\..\tools\RimWorldModding.Mcp\RimWorldModding.Mcp.csproj" />
    <ProjectReference Include="..\..\tools\RimWorldDevGateway.EndToEndHost\RimWorldDevGateway.EndToEndHost.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="BuildGatewayCompanionFixture" BeforeTargets="Build">
    <MSBuild Projects="../../tools/RimWorldDevGateway.Client/RimWorldDevGateway.Client.csproj"
             Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="BuildEndToEndMetadataFixtures" BeforeTargets="Build">
    <MSBuild Projects="../Fixtures/EndToEndHost.ValidFixtures/EndToEndHost.ValidFixtures.csproj;../Fixtures/EndToEndHost.InvalidFixtures/EndToEndHost.InvalidFixtures.csproj;../Fixtures/EndToEndHost.LookalikeFixtures/EndToEndHost.LookalikeFixtures.csproj"
             Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
