<Project Sdk="Zlepper.RimWorld.ModSdk.Testing/0.0.9">
  <PropertyGroup>
    <RimWorldPath>$(DefaultRimWorldPath)</RimWorldPath>
    <RimWorldManagedPath>$(RimWorldPath)\RimWorldWin64_Data\Managed</RimWorldManagedPath>
    <SteamModContentFolder>$(DefaultSteamModContentFolder)</SteamModContentFolder>
    <CircinusAssemblyPath Condition="'$(CircinusAssemblyPath)' == ''">$(SteamModContentFolder)\3773680130\Assemblies\Circinus.dll</CircinusAssemblyPath>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$(SteamModContentFolder)\2009463077\Current\Assemblies\0Harmony.dll</HarmonyAssemblyPath>
    <RootNamespace>RimWorldDevGateway.CircinusShape.Tests</RootNamespace>
    <AssemblyName>RimWorldDevGateway.CircinusShape.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\mods\RimWorldDevGateway\RimWorldDevGateway.csproj" />
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Update="NUnit3TestAdapter" Version="6.2.0" PrivateAssets="all" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CircinusAssemblyPath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(CircinusAssemblyPath)'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HarmonyAssemblyPath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(HarmonyAssemblyPath)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateCircinusTestAssembly" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(CircinusAssemblyPath)')" Text="The Circinus test assembly does not exist: $(CircinusAssemblyPath)." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="The Harmony test dependency does not exist: $(HarmonyAssemblyPath)." />
  </Target>
</Project>
